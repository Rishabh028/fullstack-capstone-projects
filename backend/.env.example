# Django Settings
DJANGO_SECRET_KEY=django-insecure-replace-me-in-production-change-this-key-1234567890
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database (PostgreSQL)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/saas_pm_db
DB_NAME=saas_pm_db
